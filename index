        let currentFilter = 'ALL';

        function renderTimeline() {
            const container = document.getElementById('timeline-container');
            container.innerHTML = '';

            timelineData.forEach((phaseData) => {
                // Filter items inside phase
                const filteredItems = phaseData.items.filter(item => {
                    if (currentFilter === 'ALL') return true;
                    return item.owner.toLowerCase().includes(currentFilter.toLowerCase());
                });

                if (filteredItems.length === 0) return;

                // Phase Header Element
                const phaseHeader = document.createElement('div');
                phaseHeader.className = "relative mb-6";
                phaseHeader.innerHTML = `
                    <div class="absolute -left-[31px] md:-left-[47px] top-0 bg-slate-900 border-2 border-${phaseData.phaseColor}-500 text-${phaseData.phaseColor}-400 w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shadow-lg shadow-${phaseData.phaseColor}-500/20">
                        <i class="fa-solid ${phaseData.icon}"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-3">
                            <h2 class="text-lg md:text-xl font-bold text-white tracking-wide">${phaseData.phase}</h2>
                            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 border border-slate-700 text-slate-300">${phaseData.phaseDate}</span>
                        </div>
                        ${phaseData.phaseSummary ? `<p class="text-xs text-slate-400 mt-1 max-w-2xl">${phaseData.phaseSummary}</p>` : ''}
                    </div>
                `;
                container.appendChild(phaseHeader);

                // Grid/Container for items in this phase
                const itemGrid = document.createElement('div');
                itemGrid.className = "grid grid-cols-1 md:grid-cols-2 gap-4 mb-10";

                filteredItems.forEach(item => {
                    const card = document.createElement('div');
                    card.className = "bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 hover:border-emerald-500/50 rounded-xl p-4 transition-all duration-200 cursor-pointer shadow-md hover:shadow-xl flex flex-col justify-between group";
                    card.onclick = () => openActionModal(item, phaseData);

                    card.innerHTML = `
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="text-[11px] font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded">
                                    ${item.owner}
                                </span>
                                <span class="text-xs font-medium text-slate-400">${item.date}</span>
                            </div>
                            <h3 class="font-semibold text-sm text-slate-100 group-hover:text-emerald-300 transition-colors leading-snug mb-2">
                                ${item.title}
                            </h3>
                            <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                                ${item.shortDesc}
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/60 flex items-center justify-between text-[11px] text-slate-400">
                            <span class="truncate max-w-[180px]"><i class="fa-solid fa-user-gear mr-1 text-slate-500"></i> ${item.roleFocus}</span>
                            <span class="text-emerald-400 font-medium group-hover:translate-x-1 transition-transform flex items-center gap-1">
                                Details <i class="fa-solid fa-chevron-right text-[10px]"></i>
                            </span>
                        </div>
                    `;
                    itemGrid.appendChild(card);
                });

                container.appendChild(itemGrid);
            });
        }

        function openActionModal(item, phaseData) {
            document.getElementById('modal-title').innerText = item.title;
            document.getElementById('modal-date').innerText = item.date;
            document.getElementById('modal-phase-badge').innerText = phaseData.phase;
            document.getElementById('modal-owner').innerText = item.owner;
            document.getElementById('modal-role').innerText = item.roleFocus;
            
            document.getElementById('modal-details').innerHTML = `
                <p class="mb-2 font-medium text-slate-100">${item.shortDesc}</p>
                <p class="text-slate-300 text-xs sm:text-sm">${item.details}</p>
            `;

            document.getElementById('modal-phase-context').innerHTML = `
                <p class="text-slate-300">${item.phaseContext}</p>
                ${phaseData.phaseSummary ? `<p class="mt-2 text-slate-400 italic">Phase Goal: ${phaseData.phaseSummary}</p>` : ''}
            `;

            document.getElementById('action-detail-modal').classList.remove('hidden');
        }

        function openOperatingModelModal() {
            document.getElementById('operating-model-modal').classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function filterByOwner(owner) {
            currentFilter = owner;
            
            // Update filter buttons styling
            document.querySelectorAll('.owner-filter-btn').forEach(btn => {
                btn.classList.remove('bg-emerald-500', 'text-slate-950');
                btn.classList.add('bg-slate-700', 'text-slate-300');
            });

            const activeBtn = document.getElementById(`filter-${owner.toLowerCase().replace('/', '')}`) || document.getElementById('filter-all');
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-700', 'text-slate-300');
                activeBtn.classList.add('bg-emerald-500', 'text-slate-950');
            }

            renderTimeline();
        }

        // Initialize on load
        window.onload = function() {
            renderTimeline();
        };
    </script>
